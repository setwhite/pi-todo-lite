{
  "name": "pi-todo-lite",
  "version": "0.1.0",
  "description": "Pi todo extension: one ordered task table above the editor, replayed after compaction, branch switch and --continue.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "todo",
    "tasks"
  ],
  "type": "module",
  "license": "MIT",
  "author": "setwhite",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/setwhite/pi-todo-lite.git"
  },
  "packageManager": "pnpm@12.3.4",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^26.6.5",
    "typebox": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
